# ============================================================================
# Stage 1: Builder — compile mmcv, flash-attn, and other native extensions
# ============================================================================
FROM --platform=linux/amd64 nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# System dependencies for building Python packages (flash-attn, mmcv, etc.)
# Clean stale package lists from the base image to avoid GPG signature errors.
RUN rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev \
    git build-essential ninja-build \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install uv package manager
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV MAX_JOBS=4

# ── Layer 1: Heavy deps (torch, flash-attn, tensorflow, etc.) ──────────────
# Only .heavy-deps-hash controls cache invalidation for this layer.
# pyproject.toml and uv.lock are bind-mounted (not COPYed) so changes
# to light deps don't trigger a rebuild of the heavy layer.
# NOTE: .heavy-deps-hash is generated by run.sh before docker build.
COPY .heavy-deps-hash /tmp/.heavy-deps-hash
RUN --mount=type=bind,source=pyproject.toml,target=/app/pyproject.toml \
    --mount=type=bind,source=uv.lock,target=/app/uv.lock \
    --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --only-group heavy

# ── Layer 2: Light deps (main + heavy group, minus already-installed heavy) ─
# Uses the same bind-mount pattern so pyproject.toml changes don't bloat the
# layer diff.  Only .deps_hash (overall hash) controls cache invalidation.
COPY .deps_hash /tmp/.deps_hash
RUN --mount=type=bind,source=pyproject.toml,target=/app/pyproject.toml \
    --mount=type=bind,source=uv.lock,target=/app/uv.lock \
    --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --group heavy

# ── Remove CUDA pip packages not needed at runtime ──────────────────────────
# Keep: cudnn (torch 2.10 needs 9.10.2, base has 9.8.0), cublas (version skew),
#       nccl (base too old), cusparselt/cuda_cupti (not in base),
#       cuda_runtime (torch needs it), cuda_nvrtc/nvjitlink (torch.compile needs them).
# Remove: packages unused by this codebase or redundant with system libs.
RUN rm -rf \
    /app/.venv/lib/python*/site-packages/nvidia/cusparse \
    /app/.venv/lib/python*/site-packages/nvidia/cusolver \
    /app/.venv/lib/python*/site-packages/nvidia/cufft \
    /app/.venv/lib/python*/site-packages/nvidia/curand \
    /app/.venv/lib/python*/site-packages/nvidia/cufile \
    /app/.venv/lib/python*/site-packages/nvidia/cuda_nvcc

# ============================================================================
# Stage 2: Runtime — slim image with only what's needed to run
# ============================================================================
FROM --platform=linux/amd64 nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

# Runtime + torch.compile deps (gcc, python3-dev for Triton JIT; devel base for CUDA headers)
RUN rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-full python3-dev \
    git gcc \
    libgl1 libglib2.0-0 \
    openssh-server \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

WORKDIR /app

# Copy the pre-built venv from the builder stage
COPY --from=builder /app/.venv /app/.venv

# Copy pyproject.toml + uv.lock for runtime (uv run needs them)
COPY pyproject.toml uv.lock ./

# Activate the virtual environment via PATH
ENV PATH="/app/.venv/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"

# SSH for RunPod/Vast: accept PUBLIC_KEY env (injected by RunPod) and run sshd.
EXPOSE 22
CMD bash -c 'if [ -n "${PUBLIC_KEY:-}" ]; then mkdir -p /root/.ssh && echo "$PUBLIC_KEY" >> /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys; fi; exec /usr/sbin/sshd -D'
