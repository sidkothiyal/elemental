FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

# System dependencies for building Python packages (flash-attn, mmcv, etc.)
# Clean stale package lists from the base image to avoid GPG signature errors.
RUN rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev \
    git build-essential ninja-build \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install uv package manager
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV MAX_JOBS=4

# ── Layer 1: Heavy deps (torch, flash-attn, tensorflow, etc.) ──────────────
# Only .heavy-deps-hash controls cache invalidation for this layer.
# pyproject.toml and uv.lock are bind-mounted (not COPYed) so changes
# to light deps don't trigger a rebuild of the heavy layer.
# NOTE: .heavy-deps-hash is generated by run.sh before docker build.
COPY .heavy-deps-hash /tmp/.heavy-deps-hash
RUN --mount=type=bind,source=pyproject.toml,target=/app/pyproject.toml \
    --mount=type=bind,source=uv.lock,target=/app/uv.lock \
    --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --only-group heavy

# ── Layer 2: All remaining deps ────────────────────────────────────────────
# Rebuilds when any dep changes (pyproject.toml or uv.lock modified),
# but heavy packages are already installed in the venv so this is fast.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --group heavy

# Activate the virtual environment via PATH
ENV PATH="/app/.venv/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"
